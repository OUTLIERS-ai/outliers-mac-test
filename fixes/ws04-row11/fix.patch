             return True
         except OSError:
-            return False
+            pass
+    sent = False
+    for p in _descendants(pid) + [pid]:
+        if p == os.getpid():
+            continue
+        try:
+            os.kill(p, signal.SIGKILL)
+            sent = True
+        except OSError:
