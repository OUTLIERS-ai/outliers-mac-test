-            return False
+            pass
+    sent = False
+    for p in _descendants(pid) + [pid]:
+        if p == os.getpid():
+            continue
+        try:
+            os.kill(p, signal.SIGKILL)
+            sent = True
+        except OSError:
+            pass
+    return sent
+
+
+def _descendants(pid):
+    """Every program started by this one, and by those, and so on (Mac and Linux)."""
+    try:
+        out = subprocess.run(["ps", "-A", "-o", "pid=,ppid="], capture_output=True, text=True,
+                             timeout=10, creationflags=NO_WINDOW).stdout or ""
+    except (OSError, subprocess.TimeoutExpired):
+        return []
+    children = {}
+    for line in out.splitlines():
+        parts = line.split()
+        if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
+            children.setdefault(int(parts[1]), []).append(int(parts[0]))
+    found, todo = [], [int(pid)]
+    while todo:
+        for kid in children.get(todo.pop(), []):
+            if kid not in found:
+                found.append(kid)
+                todo.append(kid)
+    return found
 
 
