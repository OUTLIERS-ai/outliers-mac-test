+#!/usr/bin/env python3
+"""Fault row 16 (build plan V3, section 6b), outliers-critic: the agent file must write its folder
+paths with `/`, never `\\`.
+
+A Mac reads `\\` as part of a file name, not as a folder break, so `Projects\\The-Critic\\Canon.md`
+names 1 file that does not exist. Claude Code on Windows accepts `/` as well, so `/` is right on
+both systems.
+
+The rule: no Markdown file in the repo may carry a `\\` between 2 path pieces (a letter, digit,
+`.`, `-`, `_` or a `<placeholder>` on the left; a letter, digit, `.`, `-` or `_` on the right),
+or a `\\` closing a folder name. The baseline harness check only looked for `Projects\\`, which
+missed 10 of the 14 lines.
+
+Run from the repo under test:   python3 _regress/test_no_backslash_paths.py
+Exit 0 = pass, 1 = fail (every hit printed with file and line).
+"""
+import re
+import sys
+from pathlib import Path
+
+sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+ROOT = Path.cwd()
+# A backslash with a path piece on its left, and a path piece, a closing backtick, a space or
+# the end of the line on its right.
+PATH_BACKSLASH = re.compile(r"[\w.\->]\\(?=[\w.\-]|`|\s|$)")
+
+
+def hits_in(path):
+    out = []
+    for n, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
+        if PATH_BACKSLASH.search(line):
+            out.append((n, line.strip()))
+    return out
+
+
+def main():
+    files = sorted(p for p in ROOT.rglob("*.md") if ".git" not in p.parts and "_regress" not in p.parts)
+    if not any(p.name == "the-critic.md" for p in files):
+        print("FAIL: the-critic.md not found under %s" % ROOT)
+        return 1
+    total = 0
+    for p in files:
+        for n, line in hits_in(p):
+            total += 1
+            print("%s line %d: backslash path | %s" % (p.relative_to(ROOT).as_posix(), n, line[:160]))
+    print("%d Markdown file(s), %d line(s) with a backslash path -> %s"
+          % (len(files), total, "FAIL" if total else "PASS"))
+    return 1 if total else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
