-        "fleetview": {"url": "http://127.0.0.1:3010", "repo": APP_REPO % "outliers-ws-02-fleetview"},
+        "projectforge": {"url": "http://127.0.0.1:3020", "repo": app_repo("outliers-ws-03-projectforge")},
+        "fleetview": {"url": "http://127.0.0.1:3010", "repo": app_repo("outliers-ws-02-fleetview")},
     },
